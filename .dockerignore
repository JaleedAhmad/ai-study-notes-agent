# Include only the application inputs used by the Dockerfile.
**
!Dockerfile
!requirements.txt
!app.py
!LICENSE
!src/
!src/**
!assets/
!assets/**
!.streamlit/
.streamlit/**
!.streamlit/config.toml

# Also exclude sensitive or generated files inside the included directories.
**/.env*
**/secrets
**/secrets.*
**/credentials*
**/service-account*.json
**/service_account*.json
**/.netrc
**/.npmrc
**/.pypirc
**/.aws
**/.azure
**/.config
**/.ssh
**/.gnupg
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa*
**/id_ed25519*
**/id_ecdsa*
**/id_dsa*

# Repository metadata and local tooling.
**/.git
**/.github
**/.agents
**/.codex
**/.vscode
**/.idea

# Databases and vector indexes, including SQLite journals.
**/chroma_db
**/vector_store
**/vector_stores
**/faiss_index
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*

# Caches, virtual environments, and build outputs.
**/__pycache__
**/*.py[cod]
**/.cache
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage*
**/htmlcov
**/.venv
**/venv
**/env
**/node_modules
**/build
**/dist
**/*.egg-info

# User material and generated or temporary outputs.
**/uploads
**/user_uploads
**/generated
**/outputs
**/exports
**/tmp
**/temp
**/scratch
**/temp_*
**/*.apkg
**/*.mp3
**/*.wav
**/*.log
**/*.tmp
**/*.bak
**/*.swp
**/*.swo
**/.DS_Store
**/Thumbs.db
